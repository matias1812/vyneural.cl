<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permisos reales usados (P1). Se solicitan BAJO DEMANDA, nunca todos al instalar. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Bug real reportado en vivo: la vibración de las alarmas nunca sonó,
         en NINGÚN test (botón de prueba, alarma nativa, FCM), sin importar
         cuántas veces se recreara el canal de notificaciones (v4/v5/v6) —
         porque este permiso, que Vibrator/NotificationChannel.enableVibration
         necesita para vibrar de verdad, nunca estuvo declarado. Es un
         permiso "normal" (se concede solo al instalar, sin diálogo). -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Sin esto, muchos fabricantes (MIUI, Samsung...) matan el ciclo de
         sincronización en segundo plano (AlarmSync, cada ~5 min): un
         recordatorio creado en la web no llega al reloj nativo hasta que el
         usuario abre la app. Se pide bajo demanda (REQUEST_IGNORE_BATTERY_
         OPTIMIZATIONS), nunca automático. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bineural"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".diag.DiagnosticsActivity"
            android:exported="false" />

        <!-- Foreground Service de audio: sostiene la reproducción en segundo
             plano / pantalla bloqueada. UN solo motor de audio (P1). -->
        <service
            android:name=".audio.AudioForegroundService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <receiver
            android:name=".notifications.AlarmReceiver"
            android:exported="false" />

        <!-- Silencia la alarma si nadie respondió dentro del límite de sonido
             (AlarmScheduler.ALARM_RING_LIMIT_MS). Solo se invoca con un
             PendingIntent explícito por alarma desde AlarmScheduler. -->
        <receiver
            android:name=".notifications.AlarmSilenceReceiver"
            android:exported="false" />

        <receiver
            android:name=".notifications.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Ciclo de sincronización del servidor (alarmas + reporte del
             dispositivo). Solo lo invoca el PendingIntent interno de
             AlarmSync; nunca se exporta. -->
        <receiver
            android:name=".sync.AlarmSyncReceiver"
            android:exported="false" />

        <!-- FCM real (P6): recordatorios que llegan aunque el proceso de la
             app esté muerto (no solo en 2.º plano) — Play Services despierta
             ESTE servicio, nunca el proceso completo de la app. REGLA DE
             ORO: onMessageReceived SOLO muestra la notificación nativa
             (NotificationHelper.showAlarm, el MISMO camino que AlarmReceiver),
             jamás arranca audio. -->
        <service
            android:name=".sync.VyneuralMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
